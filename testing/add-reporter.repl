(begin-tx "Add new reporter")
(namespace 'ORACLE_NS)
(use oracle)
(env-keys ["ops"])
(env-data {
    'bob-key: {'keys: ["bob-key"]},
    'alice-key: {'keys: ["alice-key"]},
    'dave-key: {'keys: ["dave-key"]},
    'kda: "KDA/USD"
})
(add-reporter "bob" (read-msg 'kda) "bobs" (read-keyset 'bob-key))
(add-reporter "alice" (read-msg 'kda) "alices" (read-keyset 'alice-key))
(add-reporter "dave" (read-msg 'kda) "daves" (read-keyset 'dave-key))

(commit-tx)