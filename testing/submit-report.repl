(begin-tx "Bob submits a report")
(namespace 'ORACLE_NS)
(use oracle)
(env-keys ["bob-key"])
(env-data {
    'kda: "KDA/USD"
})

(env-chain-data { 'block-time: (time "1969-01-01T00:00:01Z")})
(expect-failure "Bob needs to wait to submit" "Too early to report" (enforce-check-reporter-time "bob"))


(env-chain-data { 'block-time: (time "1970-01-01T00:00:01Z")})
(expect "Bob submits his price" "Write succeeded" (submit-report (read-msg 'kda) "bob" 0.62))
(expect "price is correct" 0.62 (at 'value (get-price (read-msg 'kda))))
(print (get-recent-reports (read-msg 'kda)))
(print ".62")
(expect-failure "Bob needs to wait to submit" "Too early to report" (enforce-check-reporter-time "bob"))

(env-keys [])
(env-chain-data { 'block-time: (time "1970-01-01T01:00:01Z")})
(expect-failure "Bob has to sign for it" "Keyset failure " (submit-report (read-msg 'kda) "bob" 0.63))

(expect-failure "No asset exists" "No value found in table" (submit-report "BAD/LUCK" "bob" 0.63))

(expect-failure "Bob tried to send a negative number" "Value must be greater than 0.0" (submit-report (read-msg 'kda) "bob" -0.62))
(commit-tx)

(begin-tx "Alice submits a report")
(namespace 'ORACLE_NS)
(use oracle)
(env-keys ["alice-key"])
(env-data {
    'kda: "KDA/USD"
})
(env-chain-data { 'block-time: (time "1970-01-01T02:00:01Z")})
(expect "Alice submits her price" "Write succeeded" (submit-report (read-msg 'kda) "alice" 0.63))

(commit-tx)

(begin-tx "Dave submits a report")
(namespace 'ORACLE_NS)
(use oracle)
(env-keys ["dave-key"])
(env-data {
    'kda: "KDA/USD"
})
(env-chain-data { 'block-time: (time "1970-01-01T03:00:01Z")})
(expect "Dave submits his price" "Write succeeded" (submit-report (read-msg 'kda) "dave" 0.64))
(expect "price is correct" 0.63 (at 'value (get-price (read-msg 'kda))))

(env-chain-data { 'block-time: (time "1970-01-01T04:00:01Z")})
(expect "Dave submits his 2nd price" "Write succeeded" (submit-report (read-msg 'kda) "dave" 0.64))
(expect "price is correct" 0.635 (at 'value (get-price (read-msg 'kda))))

(env-chain-data { 'block-time: (time "1970-01-01T05:30:01Z")})
(expect "Dave submits his 3rd price" "Write succeeded" (submit-report (read-msg 'kda) "dave" 0.65))
(expect "price is correct" 0.64 (at 'value (get-price (read-msg 'kda))))

(env-chain-data { 'block-time: (time "1970-01-01T06:32:01Z")})
(expect "Dave submits his 4th price" "Write succeeded" (submit-report (read-msg 'kda) "dave" 0.70))
(expect "price is correct as the first entry drops off" 0.64 (at 'value (get-price (read-msg 'kda))))
(commit-tx)

