;; This is a read-only tests and I like to keep them disabled unless needed for debugging

(begin-tx "Read only testing")
(namespace 'ORACLE_NS)
(use oracle)
(env-data {
    'kda: "KDA/USD"
})
;  (print (get-recent-reports (read-msg 'kda)))
;  (print (get-price (read-msg 'kda)))
;  (print (check-reporter-time "bob"))
;  (print (check-reporter-time "alice"))
;  (print (reporter-info "bob" (read-msg 'kda)))
;  (print (get-report-time (format "KDA/USD:bob:{}" [(time "1970-01-01T00:00:01Z")])))

(expect "Bob is healthy" false (reporter-health-check "bob" (read-msg 'kda)))
(enforce (< (env-gas) 10000) "Gas should be less than 10,000")
(expect "Five entries" 5 (length (get-recent-reports (read-msg 'kda))))

;  (print (get-reporters-by-symbols (read-msg 'kda)))
(commit-tx)